print('Quin és el teu primer número?')
n1=int(input(''))
print('Quin és el teu segon número?')
n2=int(input(''))
suma=n1+n2

if suma > 10:
    print ('La suma és major que 10')
else: print ('La suma és menor o igual que 10')    
#Operador or (o)
if (suma > 8 or suma < 4): {
    print ('La suma és major que 8 o més petita que 4')
}
#Oprerador and (i)
if (suma > 12 and suma <18): {
    print ('La suma és major que 12 i més petita que 18')
}

#Operador not (no)
if not (suma) == 13: {
    print ('La suma no és 13')
}

if not (suma) == 15: {
    print ('La suma no és 15')
}
elif (suma) == 15: print ('La suma és 15')


