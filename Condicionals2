print('Quin és el teu primer número?')
n1=int(input(''))
print('Quin és el teu segon número?')
n2=int(input(''))

print ('Vols sumar, restar, multiplicar, dividir, elevar, fer el módul o fer la divisió entera?')
operation=input('')

if operation=='sumar':
    print(n1+n2)

elif operation == 'restar':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '-', n2)
    print('opció 2:', n2, '-', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        print(n2 - n1)
    else:
        print(n1 - n2)

elif operation=='multiplicar':
    print(n1*n2)

elif operation == 'dividir':
    if n2 == 0:
        print("Error: No es pot dividir entre zero.")
    else:
        print(n1 / n2)
        
    if n1 == 0:
        print("Error: No es pot dividir entre zero.")
    else:
        print(n2 / n1)

elif operation == 'elevar':
    if n1 == 0 and n2 < 0:
        print("Error: No es pot elevar 0 a un exponent negatiu.")
    else:
        print(n1 ** n2)
        
    if n2 == 0 and n1 < 0:
        print("Error: No es pot elevar 0 a un exponent negatiu.")
    else:
        print(n2 ** n1)

elif operation == 'fer el módul':
    if n1 == 0:
        print("Error: No es pot fer el módul amb zero.")
    else:
        print(n1 % n2)
        
    if n2 == 0:
        print("Error: No es pot fer el módul amb zero.")
    else:
        print(n2 % n1)

elif operation == 'fer la divisió entera':
    if n2 == 0:
        print("Error: No es pot fer la divisió entera entre zero.")
    else:
        print(n1 // n2)
        
    if n1 == 0:
        print("Error: No es pot fer la divisió entera entre zero.")
    else:
        print(n2 // n1)    