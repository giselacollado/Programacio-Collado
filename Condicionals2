print('Quin és el teu primer número?')
n1=int(input(''))
print('Quin és el teu segon número?')
n2=int(input(''))

print ('Vols sumar, restar, multiplicar, dividir, elevar, fer el módul o fer la divisió entera?')
operation=input('')

if operation=='sumar':
    print(n1+n2)

elif operation == 'restar':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '-', n2)
    print('opció 2:', n2, '-', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        print(n2 - n1)
    else:
        print(n1 - n2)

elif operation=='multiplicar':
    print(n1*n2)

elif operation == 'dividir':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '/', n2)
    print('opció 2:', n2, '/', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        if n1 <= 0:
            print('ERROR, no es pot dividir entre 0 ni nombres negatius')
        else:
            print(n2 / n1)
    else:  
        if n2 <= 0:
            print('ERROR, no es pot dividir entre 0 ni nombres negatius')
        else:
            print(n1 / n2)

elif operation == 'elevar':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '**', n2)
    print('opció 2:', n2, '**', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        if n1 < 0 and n2 == 0:
            print('ERROR, no es pot elevar 0 a un nombre negatiu')
        else:
            print(n2 ** n1)
    else:
        if n2 < 0 and n1 == 0:
            print('ERROR, no es pot elevar 0 a un nombre negatiu')
        else:
            print(n1 ** n2)

elif operation == 'fer el módul':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '%', n2)
    print('opció 2:', n2, '%', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        if n1 <= 0:
            print('ERROR, no es pot fer el módul de 0 ni nombres negatius')
        else:
            print(n2 % n1)
    else:
        if n2 <= 0:
            print('ERROR, no es pot fer el módul de 0 ni nombres negatius')
        else:
            print(n1 % n2)

elif operation == 'fer la divisió entera':
    print('Quin ordre prefereixes?')
    print('opció 1:', n1, '//', n2)
    print('opció 2:', n2, '//', n1)
    
    opcion = int(input('Escriu 1 o 2: '))
    
    if opcion == 2:
        if n1 <= 0:
            print('ERROR, no es pot fer la divisió entera entre 0 ni nombres negatius')
        else:
            print(n2 // n1)
    else:
        if n2 <= 0:
            print('ERROR, no es pot fer la divisió entera entre 0 ni nombres negatius')
        else:
            print(n1 // n2)